---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Brutalist Warm — Open Sign Web Co"
  description="Real websites for small businesses, at a price small businesses can afford. $25/mo, no lock-in."
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;700;900&family=JetBrains+Mono:wght@700&display=swap"
      rel="stylesheet"
    />
    <style>
      body { background-color: #F5EDDC; }
      .font-grotesk { font-family: 'Space Grotesk', sans-serif; }
      .font-mono-accent { font-family: 'JetBrains Mono', monospace; }
      .text-ink { color: #3B2F1F; }
      .text-cream { color: #F5EDDC; }
      .text-amber { color: #B45309; }
      .bg-cream { background-color: #F5EDDC; }
      .bg-amber { background-color: #B45309; }
      .border-ink { border-color: #3B2F1F; }
    </style>
  </Fragment>

  <div class="font-grotesk text-[#3B2F1F] bg-[#F5EDDC] min-h-screen">

    <!-- Header -->
    <header class="border-b-[3px] border-[#3B2F1F]">
      <div class="px-6 py-5 max-w-[1400px] mx-auto">
        <span class="font-grotesk font-bold text-xl tracking-tight uppercase">
          OPEN SIGN <span class="text-[#B45309]">WEB</span> CO
        </span>
      </div>
    </header>

    <!-- Hero -->
    <section class="px-6 pt-16 pb-12 md:pt-24 md:pb-20 max-w-[1400px] mx-auto overflow-hidden">
      <h1
        class="font-grotesk font-black leading-[0.95] tracking-tighter text-[#3B2F1F] mb-8"
        style="font-size: clamp(3rem, 10vw, 7.5rem); font-weight: 900;"
      >
        Real websites<br />
        for small<br />
        businesses,<br />
        at a price<br />
        small businesses<br />
        can afford.
      </h1>
      <p
        class="font-grotesk text-[#3B2F1F] leading-[1.5] max-w-[600px]"
        style="font-size: clamp(1rem, 2vw, 1.25rem); opacity: 0.75;"
      >
        Built by us, hosted by us, changed by emailing us. $25/mo monthly, or $19/mo if you pay
        yearly. Your website and domain are yours from day one.
      </p>
    </section>

    <hr class="border-t-[4px] border-[#3B2F1F]" />

    <!-- Pricing -->
    <section class="max-w-[1400px] mx-auto px-6 py-16 md:py-24">
      <h2
        class="font-grotesk font-black uppercase tracking-tighter mb-12"
        style="font-size: clamp(2rem, 5vw, 4rem); font-weight: 900;"
      >
        Pricing,<br class="sm:hidden" /> in plain English
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-0 border-[3px] border-[#3B2F1F]">
        <!-- Monthly -->
        <div class="p-8 md:border-r-[3px] border-b-[3px] md:border-b-0 border-[#3B2F1F]">
          <p class="font-mono-accent font-bold text-[#B45309] mb-4" style="font-size: clamp(2.5rem, 5vw, 4rem);">
            $25/MO
          </p>
          <p class="font-grotesk font-bold text-[#3B2F1F] text-lg mb-2">Monthly billing</p>
          <p class="font-grotesk text-[#3B2F1F] leading-[1.5]" style="opacity: 0.7;">
            Cancel anytime. No build fee.
          </p>
        </div>
        <!-- Annual -->
        <div class="p-8">
          <p class="font-mono-accent font-bold text-[#B45309] mb-4" style="font-size: clamp(2.5rem, 5vw, 4rem);">
            $19/MO
          </p>
          <p class="font-grotesk font-bold text-[#3B2F1F] text-lg mb-2">Billed annually ($228/year)</p>
          <p class="font-grotesk text-[#3B2F1F] leading-[1.5]" style="opacity: 0.7;">
            No build fee. The annual prepayment is non-refundable, but your website and domain are always yours.
          </p>
        </div>
      </div>
    </section>

    <hr class="border-t-[4px] border-[#3B2F1F]" />

    <!-- What's included -->
    <section class="max-w-[1400px] mx-auto px-6 py-16 md:py-24">
      <h2
        class="font-grotesk font-black uppercase tracking-tighter mb-12"
        style="font-size: clamp(2rem, 5vw, 4rem); font-weight: 900;"
      >
        What's included
      </h2>
      <div class="md:pl-12 space-y-0">
        <div class="flex gap-4 items-start py-5 border-b-[2px] border-[#3B2F1F]">
          <span class="font-grotesk font-bold text-[#B45309] text-xl leading-[1.5] shrink-0">—</span>
          <p class="font-grotesk text-[#3B2F1F] leading-[1.5]">
            A website designed for your business, not adapted from a template
          </p>
        </div>
        <div class="flex gap-4 items-start py-5 border-b-[2px] border-[#3B2F1F]">
          <span class="font-grotesk font-bold text-[#B45309] text-xl leading-[1.5] shrink-0">—</span>
          <p class="font-grotesk text-[#3B2F1F] leading-[1.5]">
            Hosting, SSL, daily backups, uptime monitoring
          </p>
        </div>
        <div class="flex gap-4 items-start py-5 border-b-[2px] border-[#3B2F1F]">
          <span class="font-grotesk font-bold text-[#B45309] text-xl leading-[1.5] shrink-0">—</span>
          <p class="font-grotesk text-[#3B2F1F] leading-[1.5]">
            Changes by email — small things just get done; bigger things we'll tell you the cost of
            before doing anything. No allowances to count, no surprises.
          </p>
        </div>
      </div>
    </section>

    <hr class="border-t-[4px] border-[#3B2F1F]" />

    <!-- What costs extra -->
    <section class="max-w-[1400px] mx-auto px-6 py-16 md:py-24">
      <h2
        class="font-grotesk font-black uppercase tracking-tighter mb-6"
        style="font-size: clamp(1.75rem, 4vw, 3.5rem); font-weight: 900;"
      >
        What costs extra<br />(and what it costs)
      </h2>
      <p class="font-grotesk text-[#3B2F1F] leading-[1.5] max-w-[600px] mb-10 md:pl-12" style="opacity: 0.7;">
        We publish this because the worst part of working with an agency is the surprise on the
        invoice. There won't be one.
      </p>
      <div class="md:pl-12 space-y-0">
        <div class="flex flex-col sm:flex-row sm:gap-8 sm:items-baseline py-5 border-b-[2px] border-[#3B2F1F]">
          <span class="font-grotesk text-[#3B2F1F] leading-[1.5] flex gap-4 items-start">
            <span class="font-bold text-[#B45309] shrink-0">→</span>
            A new page on your site
          </span>
          <span class="font-grotesk font-bold text-[#3B2F1F] sm:ml-auto shrink-0 pl-6 sm:pl-0">$50, flat</span>
        </div>
        <div class="flex flex-col sm:flex-row sm:gap-8 sm:items-baseline py-5 border-b-[2px] border-[#3B2F1F]">
          <span class="font-grotesk text-[#3B2F1F] leading-[1.5] flex gap-4 items-start">
            <span class="font-bold text-[#B45309] shrink-0">→</span>
            A major redesign
          </span>
          <span class="font-grotesk text-[#3B2F1F] sm:ml-auto shrink-0 pl-6 sm:pl-0" style="opacity:0.7;">quoted per project, in writing, before any work</span>
        </div>
        <div class="flex flex-col sm:flex-row sm:gap-8 sm:items-baseline py-5 border-b-[2px] border-[#3B2F1F]">
          <span class="font-grotesk text-[#3B2F1F] leading-[1.5] flex gap-4 items-start">
            <span class="font-bold text-[#B45309] shrink-0">→</span>
            Integrations (booking, e-commerce, custom forms)
          </span>
          <span class="font-grotesk text-[#3B2F1F] sm:ml-auto shrink-0 pl-6 sm:pl-0" style="opacity:0.7;">quoted per project</span>
        </div>
        <div class="flex flex-col sm:flex-row sm:gap-8 sm:items-baseline py-5 border-b-[2px] border-[#3B2F1F]">
          <span class="font-grotesk text-[#3B2F1F] leading-[1.5] flex gap-4 items-start">
            <span class="font-bold text-[#B45309] shrink-0">→</span>
            Domain registration
          </span>
          <span class="font-grotesk text-[#3B2F1F] sm:ml-auto shrink-0 pl-6 sm:pl-0" style="opacity:0.7;">at our cost, no markup</span>
        </div>
        <div class="flex flex-col sm:flex-row sm:gap-8 sm:items-baseline py-5 border-b-[2px] border-[#3B2F1F]">
          <span class="font-grotesk text-[#3B2F1F] leading-[1.5] flex gap-4 items-start">
            <span class="font-bold text-[#B45309] shrink-0">→</span>
            Anything else
          </span>
          <span class="font-grotesk text-[#3B2F1F] sm:ml-auto shrink-0 pl-6 sm:pl-0" style="opacity:0.7;">quoted in writing first, every time</span>
        </div>
      </div>
    </section>

    <!-- Lock-in — full-width amber block -->
    <section class="bg-[#B45309]">
      <div class="max-w-[1400px] mx-auto px-6 py-16 md:py-24">
        <h2
          class="font-grotesk font-black uppercase tracking-tighter text-[#F5EDDC] mb-8"
          style="font-size: clamp(2rem, 5vw, 4.5rem); font-weight: 900;"
        >
          Your website,<br />your domain,<br />always.
        </h2>
        <p class="font-grotesk text-[#F5EDDC] leading-[1.5] max-w-[640px]" style="font-size: 1.125rem; opacity: 0.9;">
          If you leave us, we hand both over. The site files, the domain — yours to take wherever
          you want, no fee, no fuss. Most agencies treat the inability to leave as a feature. We
          think that's backwards.
        </p>
      </div>
    </section>

    <hr class="border-t-[4px] border-[#3B2F1F]" />

    <!-- Who we are -->
    <section class="max-w-[1400px] mx-auto px-6 py-16 md:py-24">
      <h2
        class="font-grotesk font-black uppercase tracking-tighter mb-8"
        style="font-size: clamp(2rem, 5vw, 4rem); font-weight: 900;"
      >
        Who we are
      </h2>
      <p class="font-grotesk text-[#3B2F1F] leading-[1.5] max-w-[640px] md:pl-12" style="font-size: 1.125rem; opacity: 0.85;">
        Open Sign Web Co is Nick and Richard, two brothers who've been small business owners and got
        tired of watching other small business owners get priced out of having a real website. We
        started this to fix that.
      </p>
    </section>

    <hr class="border-t-[4px] border-[#3B2F1F]" />

    <!-- CTA -->
    <section class="max-w-[1400px] mx-auto px-6 py-16 md:py-24">
      <h2
        class="font-grotesk font-black uppercase tracking-tighter mb-6"
        style="font-size: clamp(1.75rem, 4.5vw, 3.5rem); font-weight: 900;"
      >
        Want to see what<br />yours could look like?
      </h2>
      <p class="font-grotesk text-[#3B2F1F] leading-[1.5] max-w-[600px] md:pl-12 mb-10" style="opacity: 0.85;">
        Tell us your business name and what you do. We'll send you two quick mockups of what your
        site could look like, free, no commitment.
      </p>

      <form
        id="contact-form"
        class="md:pl-12 max-w-[640px] grid gap-5"
        novalidate
      >
        <label class="grid gap-2">
          <span class="font-grotesk font-bold text-[#3B2F1F] uppercase tracking-wide" style="font-size: 0.875rem;">Your name</span>
          <input
            type="text"
            name="name"
            required
            class="font-grotesk text-[#3B2F1F] bg-[#F5EDDC] border-[3px] border-[#3B2F1F] px-4 py-3"
            style="font-size: 1rem; outline: none;"
          />
        </label>

        <label class="grid gap-2">
          <span class="font-grotesk font-bold text-[#3B2F1F] uppercase tracking-wide" style="font-size: 0.875rem;">Business name</span>
          <input
            type="text"
            name="businessName"
            required
            class="font-grotesk text-[#3B2F1F] bg-[#F5EDDC] border-[3px] border-[#3B2F1F] px-4 py-3"
            style="font-size: 1rem; outline: none;"
          />
        </label>

        <label class="grid gap-2">
          <span class="font-grotesk font-bold text-[#3B2F1F] uppercase tracking-wide" style="font-size: 0.875rem;">What you do</span>
          <textarea
            name="description"
            required
            rows="4"
            class="font-grotesk text-[#3B2F1F] bg-[#F5EDDC] border-[3px] border-[#3B2F1F] px-4 py-3 resize-y"
            style="font-size: 1rem; outline: none;"
          ></textarea>
        </label>

        <label class="grid gap-2">
          <span class="font-grotesk font-bold text-[#3B2F1F] uppercase tracking-wide" style="font-size: 0.875rem;">Your email</span>
          <input
            type="email"
            name="email"
            required
            class="font-grotesk text-[#3B2F1F] bg-[#F5EDDC] border-[3px] border-[#3B2F1F] px-4 py-3"
            style="font-size: 1rem; outline: none;"
          />
        </label>

        <div class="flex flex-col sm:flex-row sm:items-center gap-4 mt-2">
          <button
            type="submit"
            class="font-grotesk font-bold uppercase tracking-wide bg-[#B45309] text-[#F5EDDC] border-[3px] border-[#3B2F1F] px-8 py-4 hover:opacity-90 disabled:opacity-50"
            style="font-size: 1rem; cursor: pointer;"
          >
            Send it over
          </button>
          <p
            id="contact-status"
            class="font-grotesk text-[#3B2F1F] leading-[1.5]"
            style="font-size: 0.95rem; opacity: 0.85;"
            aria-live="polite"
          ></p>
        </div>
      </form>
    </section>

    <script is:inline>
      (function () {
        const form = document.getElementById('contact-form');
        if (!form) return;
        const status = document.getElementById('contact-status');
        const button = form.querySelector('button[type="submit"]');

        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          if (!status || !button) return;

          status.style.color = '#3B2F1F';
          status.textContent = 'Sending…';
          button.disabled = true;

          const data = new FormData(form);
          const payload = {
            name: String(data.get('name') || '').trim(),
            businessName: String(data.get('businessName') || '').trim(),
            description: String(data.get('description') || '').trim(),
            email: String(data.get('email') || '').trim(),
          };

          if (!payload.name || !payload.businessName || !payload.description || !payload.email) {
            status.style.color = '#B45309';
            status.textContent = 'Please fill in every field before sending.';
            button.disabled = false;
            return;
          }

          try {
            const res = await fetch('/api/contact', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
            const body = await res.json().catch(() => ({}));

            if (res.ok && body && body.success) {
              form.reset();
              status.style.color = '#3B2F1F';
              status.textContent = "Got it — we'll be in touch soon.";
            } else {
              status.style.color = '#B45309';
              status.textContent =
                (body && body.error) ||
                "Something went wrong — try again, or email hello@opensignwebco.com directly.";
            }
          } catch {
            status.style.color = '#B45309';
            status.textContent =
              "Couldn't reach the server — try again, or email hello@opensignwebco.com directly.";
          } finally {
            button.disabled = false;
          }
        });
      })();
    </script>

    <!-- Footer -->
    <footer class="border-t-[4px] border-[#3B2F1F]">
      <div class="max-w-[1400px] mx-auto px-6 py-8">
        <p class="font-grotesk text-sm text-[#3B2F1F]" style="opacity: 0.6;">
          Open Sign Web Co — hello@opensignwebco.com — 2026
        </p>
      </div>
    </footer>

  </div>
</BaseLayout>
