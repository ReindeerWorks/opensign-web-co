# Copy to .env and fill in values.
#
# Airtable (CRM / pipeline) — used by scripts/*.py and the Cloudflare Pages
# Functions. REUSE these exact names; do not invent Airtable-specific aliases.
OPENSIGN_AT_BASE_ID=
OPENSIGN_AT_BASE_API_KEY=

# Lead generation / content.
GOOGLE_PLACES_API_KEY=
ANTHROPIC_API_KEY=

# Email send (Resend) — functions/api/contact.ts
RESEND_API_KEY=

# Postmark inbound webhook Basic Auth — functions/api/inbound/postmark.ts
# Set the same pair as Secrets in the Cloudflare Pages dashboard, and embed
# them in the Postmark inbound URL: https://USER:PASS@<domain>/api/inbound/postmark
POSTMARK_WEBHOOK_USER=
POSTMARK_WEBHOOK_PASS=
